# Local development points at the Postgres container from docker-compose.yml
DATABASE_URL="postgresql://bwa:bwa@localhost:5433/bwa_tasks?schema=public"

# Separate database used by `npm run test:e2e` — it is truncated between tests
TEST_DATABASE_URL="postgresql://bwa:bwa@localhost:5433/bwa_tasks_test?schema=public"

PORT=3000

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"
